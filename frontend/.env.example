# REST API base URL (include /api).
VITE_API_URL=http://localhost:5000/api

# Optional Socket.IO server URL. If omitted, VITE_API_URL is used without its trailing /api.
VITE_SOCKET_URL=http://localhost:5000

# Optional temporary TeamChatPage diagnostics.
VITE_CHAT_DEBUG=false

# Socket.IO requires a persistent Node.js server; it cannot run on a serverless-only deployment.
