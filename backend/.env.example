PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Comma-separated origins are supported, for example:
# FRONTEND_URL=http://localhost:5173,https://app.example.com
# Enable temporary socket diagnostics while reproducing a chat issue:
CHAT_DEBUG=false

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DATABASE_NAME=startuplink

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Socket.IO requires a persistent Node.js server; it cannot run on a serverless-only deployment.

# AI analysis (Vercel AI SDK)
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
# GEMINI_API_KEY=your-google-ai-api-key
# The key must be a Google AI Studio Gemini key. OPENAI_API_KEY is only for AI_PROVIDER=openai.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
